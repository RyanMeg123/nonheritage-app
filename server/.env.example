# ─────────────────────────────────────────────────────────────────
# 非遗定制平台后端 · 环境变量示例
# 复制本文件为 .env，按实际情况填写
# ─────────────────────────────────────────────────────────────────

# 服务端口（默认 4300）
PORT=4300
NODE_ENV=development

# ── PostgreSQL (阿里云 RDS) ──────────────────────────────────────
# 格式：postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL=postgresql://root:your_password@rm-xxx.rds.aliyuncs.com:5432/nonheritage?schema=public

# ── 七牛云对象存储（优先） ────────────────────────────────────────
QINIU_ACCESS_KEY=your_qiniu_access_key
QINIU_SECRET_KEY=your_qiniu_secret_key
QINIU_BUCKET=your-qiniu-bucket
QINIU_BUCKET_DOMAIN=https://your-bucket-domain
# 华东一般可填 z0；华北 z1；华南 z2；北美 na0；东南亚 as0
QINIU_REGION=z0

# ── 阿里云 OSS（备选） ───────────────────────────────────────────
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=your-bucket-name
# 公开访问域名（Bucket 绑定的自定义域名或默认域名）
OSS_BASE_URL=https://your-bucket.oss-cn-hangzhou.aliyuncs.com

# ── aihubmix AI 代理 ─────────────────────────────────────────────
# 统一入口：https://aihubmix.com
# 文本模型（1/2/4/5）：gpt-5.3-chat-latest，走 OpenAI 兼容接口
# 图像模型（3）：doubao-seedream-5.0-lite，走 doubao predictions 接口
AIHUBMIX_API_KEY=sk-xxxxxxxxxxxx

# ── AI Adapter 开关 ──────────────────────────────────────────────
# 设置为 aihubmix 启用真实 AI；留空或其他值走 mock
AI_REQUIREMENT_PARSER=aihubmix
AI_CRAFT_PLAN_GEN=aihubmix
AI_PREVIEW_RENDERER=aihubmix
AI_ARTISAN_MATCHER=aihubmix
AI_DESIGN_CONFIRM=aihubmix

# ── Sentry (可选) ────────────────────────────────────────────────
# SENTRY_DSN=https://xxx@sentry.io/xxx
